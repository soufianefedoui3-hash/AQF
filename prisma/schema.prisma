generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model ConsultationRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model AccompagnementRequest {
  id              String   @id @default(cuid())
  sector          String
  entityName      String
  responsableName String   @default("")
  phone           String   @default("")
  email           String   @default("")
  entityDetails   String
  requestType     String   @default("")
  appointmentDate String?
  appointmentTime String?
  status          String   @default("new")
  createdAt       DateTime @default(now())
}

model FormationRequest {
  id           String   @id @default(cuid())
  trainingType String
  audienceType String?
  contactName  String
  contactEmail String
  contactPhone String
  message      String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
}

model AuditRequest {
  id                String   @id @default(cuid())
  norms             String
  customNorm        String?
  auditNature       String
  customAuditNature String?
  companyName       String
  companyActivity   String   @default("")
  contactName       String
  contactEmail      String
  contactPhone      String   @default("")
  status            String   @default("new")
  createdAt         DateTime @default(now())
}

model FormationType {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebServiceRequest {
  id              String   @id @default(cuid())
  responsableName String
  companyName     String
  phone           String
  requestInfo     String?
  appointmentDate String?
  appointmentTime String?
  status          String   @default("new")
  createdAt       DateTime @default(now())
}

model Sector {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  imageUrl    String?
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model AboutSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  skills    String
  imageUrl  String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  content   String
  updatedAt DateTime @updatedAt
}

model GedService {
  id          String   @id @default("default")
  title       String
  description String
  imageUrl    String?
  updatedAt   DateTime @updatedAt
}

model ProductPack {
  id          String   @id @default(cuid())
  name        String
  description String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CareersSettings {
  id        String   @id @default("default")
  title     String
  content   String
  email     String
  phone     String
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id            String   @id @default(cuid())
  positionName  String
  applicantName String
  email         String
  phone         String?
  cvPath        String
  letterPath    String
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model SiteSettings {
  id             String   @id @default("default")
  whatsappNumber String   @default("+212600000000")
  contactEmail   String   @default("contact@aqf.ma")
  contactPhone   String   @default("+212600000000")
  address        String   @default("Maroc")
  updatedAt      DateTime @updatedAt
}
