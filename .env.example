# =============================================================================
# AQF — environment variables (Hostinger: set these in hPanel → Node.js App)
# =============================================================================

# SQLite (local/dev). On Hostinger leave unset → app uses prisma/production.db
DATABASE_URL="file:./dev.db"

# Required in production for secure JWT sessions
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Canonical admin login (plaintext in env — bcrypt hash is stored in SQLite Admin)
# Confirmed default email: admin@aqf.ma
ADMIN_EMAIL="admin@aqf.ma"
ADMIN_PASSWORD="Admin@AQF2026"

# Optional: force rewrite Admin.passwordHash from ADMIN_PASSWORD on next bootstrap
# ADMIN_FORCE_RESET="true"

# Optional: Secure cookie override (auto-detects x-forwarded-proto by default)
# COOKIE_SECURE="true"

# Optional: skip DB hooks (emergency only)
# SKIP_DB_BOOTSTRAP="true"
# SKIP_DB_SEED="true"

# Optional: bootstrap/fix-admin API secrets
# SETUP_SECRET="your-long-random-setup-secret"
# FIX_ADMIN_SECRET="your-long-random-setup-secret"
